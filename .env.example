# Copy to `.env` and fill in. `.env` is gitignored — never commit a real token.
#
# `npm run inspect*` reads this file and hands the credentials to the MCP
# Inspector: as per-call `_meta` for the CLI, and as the server's single-user
# fallback for the web UI and TUI, which have no way to set `_meta`.

# The Hermes access token to act as, and the store to act on. Get both by
# logging into the Dashboard for that store and copying STORE_ACCESS_TOKEN and
# STORE_ID out of localStorage. Set both together, or neither.
#
# This is a single-user fallback, for inspecting and for local scripts. A real
# client (the AI Server, an agent) ignores this entirely and sends each end
# user's own credentials in `_meta` per call.
# NOTE: HERMES_SINGLE_USER does NOT go in this file. It is the switch that
# decides whether this file is read at all, so it is read from the real
# environment before the file is opened — a `.env` that could turn on its own
# loading would let a file dropped in a shared process's working directory
# redirect that process at another host.
#
# Set it where the process is started instead:
#
#   - `.mcp.json` / your client's server config:  "HERMES_SINGLE_USER": "1"
#   - a shell run:  HERMES_SINGLE_USER=1 node dist/server.js
#   - `npm run inspect*` sets it for you
#
# Without it, a tool call carrying no credentials of its own is refused rather
# than served as whoever is configured here — which is the right answer in the
# shared process the ai-agent runs, and the reason the default is off.

# Which file the stdio entry reads these values from, resolved against the
# working directory. Defaults to `.env`, and only ever read when
# HERMES_SINGLE_USER=1. Set it to empty to read no file at all.
#HERMES_ENV_FILE=.env

HERMES_ACCESS_TOKEN=
HERMES_STORE_ID=

# Optional. Copy STORE_REFRESH_TOKEN from the same localStorage. With it, the
# server renews the access token above when it expires, so a long session does
# not die mid-run; without it, copy a fresh access token when it expires. Needs
# the two above alongside it.
HERMES_REFRESH_TOKEN=

# Minimum severity that reaches stderr: silent | error | warn | info | debug
HERMES_MCP_LOG_LEVEL=info

# Host root Hermes Atlas tool calls go to (NOT the OpenAPI docs URL below)
HERMES_BASE_URL=https://hermes-atlas.vajro.com

# Where the live OpenAPI spec is fetched from, to keep tool schemas current.
# Separate setting from HERMES_BASE_URL, but keep the two on the same
# environment: refreshing schemas from prod while calling dev serves wrong
# schemas for the host you are actually talking to.
HERMES_OPENAPI_DOCS_URL=https://hermes-atlas.vajro.com/v3/api-docs

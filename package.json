{
  "name": "hermes-mcp",
  "version": "0.1.0",
  "files": [
    "dist",
    "openapi/hermes-api-docs.json",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.apkg.io/vajro/"
  },
  "bin": {
    "hermes-mcp": "dist/server.js",
    "hermes-mcp-http": "dist/httpServer.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "inspect": "npm run build && node scripts/inspect.mjs --web",
    "inspect:cli": "npm run build && node scripts/inspect.mjs --cli",
    "inspect:tui": "npm run build && node scripts/inspect.mjs --tui",
    "inspect:smoke": "npm run build && node scripts/inspect-smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start:http": "node dist/httpServer.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/inspector": "^2.6.0",
    "@types/node": "^20.14.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
